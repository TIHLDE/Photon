{
    "name": "@photon/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "build": "bun build src/index.ts src/migrate.ts --outdir dist --target bun --sourcemap --external sharp",
        "start": "bun dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.927.0",
        "@dotenvx/dotenvx": "catalog:backend",
        "@hono/mcp": "^0.1.4",
        "@hono/standard-validator": "^0.1.5",
        "@photon/auth": "workspace:*",
        "@photon/core": "workspace:*",
        "@photon/db": "workspace:*",
        "@photon/email": "workspace:*",
        "@react-pdf/renderer": "^4.3.0",
        "@scalar/hono-api-reference": "^0.9.16",
        "@socotra/modelcontextprotocol-sdk": "^1.18.0",
        "@vippsmobilepay/sdk": "^2.4.2",
        "bowser": "^2.15.0",
        "date-fns": "catalog:",
        "date-fns-tz": "catalog:",
        "drizzle-orm": "catalog:backend",
        "drizzle-seed": "catalog:backend",
        "es-toolkit": "catalog:",
        "hono": "catalog:backend",
        "hono-openapi": "^1.0.2",
        "isbot": "^5.2.2",
        "node-cron": "^4.2.1",
        "pdf-lib": "^1.17.1",
        "pino": "^10.3.1",
        "react": "catalog:frontend",
        "sharp": "^0.35.3",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.4.6",
        "@photon/tsconfig": "workspace:*",
        "@testcontainers/postgresql": "^12.2.1",
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "catalog:backend",
        "@types/react": "catalog:frontend",
        "@vitest/coverage-v8": "^5.1.0",
        "better-auth": "catalog:backend",
        "jose": "catalog:backend",
        "pg": "catalog:backend",
        "pino-pretty": "^13.2.0",
        "testcontainers": "^12.2.1",
        "typescript": "catalog:",
        "vitest": "catalog:testing"
    }
}

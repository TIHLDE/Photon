# Photon API base URL (without trailing slash for auth, with for API client)
VITE_AUTH_BASE_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/

# Optional analytics
VITE_POSTHOG_KEY=phc_xxx

# Set to "true" to show the "Logg inn med Feide" button (backend Feide client must be configured too)
VITE_FEIDE_ENABLED=false

{
    "name": "photon",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*",
            "infra/*"
        ],
        "catalog": {
            "typescript": "^7.0.2",
            "zod": "^4.1.5",
            "@types/bun": "^1.4.2",
            "@types/node": "^26.5.1",
            "oxfmt": "^0.67.0",
            "oxlint": "^1.82.0",
            "date-fns": "^4.4.0",
            "date-fns-tz": "^3.2.0",
            "tsdown": "^0.23.0"
        },
        "catalogs": {
            "testing": {
                "vitest": "^5.0.0"
            },
            "backend": {
                "pg": "^8.18.0",
                "@types/pg": "^8.16.0",
                "bullmq": "^5.70.1",
                "hono": "^4.11.7",
                "@dotenvx/dotenvx": "^1.52.0",
                "drizzle-orm": "^0.44.5",
                "drizzle-seed": "^0.3.1",
                "drizzle-kit": "^0.31.4",
                "better-auth": "^1.6.9",
                "jose": "^6.2.3",
                "@better-auth/oauth-provider": "^1.6.9"
            },
            "frontend": {
                "react": "^19.3.0",
                "react-dom": "^19.3.0",
                "@types/react": "^19.3.0",
                "@types/react-dom": "^19.3.0",
                "@tailwindcss/vite": "^4.3.3",
                "@tailwindcss/typography": "^0.5.20",
                "tw-animate-css": "^1.4.0",
                "tailwind-merge": "^3.6.0",
                "lucide-react": "^0.577.0",
                "recharts": "3.8.0",
                "@tanstack/react-table": "^8.21.3",
                "@tiptap/react": "^3.22.4",
                "clsx": "^2.1.1",
                "class-variance-authority": "^0.7.1",
                "tailwindcss": "^4.3.3"
            }
        }
    },
    "type": "module",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "start": "turbo start",
        "test": "turbo test",
        "typecheck": "turbo typecheck",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check",
        "format:fix": "oxfmt .",
        "db:push": "turbo db:push",
        "db:check-order": "turbo db:check-order",
        "db:generate": "turbo db:generate",
        "db:migrate": "turbo db:migrate",
        "db:studio": "turbo db:studio",
        "email": "turbo email",
        "docker:dev": "turbo dev:up --filter=@photon/docker",
        "docker:dev:down": "turbo dev:down --filter=@photon/docker",
        "docker:fresh": "turbo dev:fresh --filter=@photon/docker",
        "docker:prod": "turbo prod:up --filter=@photon/docker",
        "docker:prod:down": "turbo prod:down --filter=@photon/docker",
        "sdk:generate": "turbo codegen --filter=@tihlde/sdk",
        "sdk:update": "turbo build --filter=@tihlde/sdk && changeset",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "turbo build --filter=@tihlde/sdk && changeset publish",
        "cut-release": "bun scripts/cut-release.ts"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@tihlde/sdk": "workspace:*",
        "@types/bun": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "ts-morph": "^27.0.2",
        "turbo": "^2.10.12",
        "typescript": "catalog:"
    },
    "packageManager": "bun@1.4.2"
}

    "dependencies": {
        "@react-email/components": "^0.5.2",
        "@react-email/render": "^1.2.2",
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@photon/tsconfig": "workspace:*",
        "@react-email/preview-server": "4.2.8",
        "@types/node": "catalog:",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "react-email": "4.2.8",
        "tsdown": "^0.21.2",
        "typescript": "catalog:"
    }
}

{
    "name": "@photon/email",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./schema": "./dist/schema.mjs",
        "./templates": "./dist/templates.mjs",
        "./*": "./*"
    },
    "scripts": {
        "build": "tsdown",

{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {},
    "rules": {},
    "settings": {
        "jsx-a11y": {
            "components": {},
            "attributes": {}
        },
        "next": {
            "rootDir": []
        },
        "react": {
            "formComponents": [],
            "linkComponents": [],
            "componentWrapperFunctions": []
        },
        "jsdoc": {
            "ignorePrivate": false,
            "ignoreInternal": false,
            "ignoreReplacesDocs": true,
            "overrideReplacesDocs": true,
            "augmentsExtendsReplacesDocs": false,
            "implementsReplacesDocs": false,
            "exemptDestructuredRootsFromChecks": false,
            "tagNamePreference": {}
        },
        "vitest": {
            "typecheck": false
        }
    },
    "env": {
        "builtin": true
    },
    "globals": {},
    "ignorePatterns": [
        "**/drizzle/**",
        "**/dist/**",
        "**/generated/**",
        "apps/web-old/**",
        "**/.oxlintrc.json",
        "**/.oxfmtrc.json"
    ],
    "overrides": [
        {
            "files": [
                "apps/api/src/**",
                "packages/auth/src/**",
                "packages/core/src/**",
                "packages/email/src/**"
            ],
            "rules": {
                "no-restricted-properties": [
                    "error",
                    {
                        "property": "toLocaleDateString",
                        "message": "Formaterer i tidssonen koden kjører i — UTC i API-containeren og på SSR-serveren, Europe/Oslo i nettleseren. Bruk formatOsloDate / formatOsloDateTime (apps/kvark/src/lib/date.ts, apps/api/src/lib/oslo-day.ts, packages/email/src/date.ts)."
                    },
                    {
                        "property": "toLocaleTimeString",
                        "message": "Formaterer i tidssonen koden kjører i — UTC i API-containeren og på SSR-serveren, Europe/Oslo i nettleseren. Bruk formatOsloDate / formatOsloDateTime (apps/kvark/src/lib/date.ts, apps/api/src/lib/oslo-day.ts, packages/email/src/date.ts)."
                    },
                    {
                        "property": "toLocaleString",
                        "message": "Formaterer i tidssonen koden kjører i — UTC i API-containeren og på SSR-serveren, Europe/Oslo i nettleseren. Bruk formatOsloDate / formatOsloDateTime (apps/kvark/src/lib/date.ts, apps/api/src/lib/oslo-day.ts, packages/email/src/date.ts)."
                    },
                    {
                        "object": "Intl",
                        "property": "DateTimeFormat",
                        "message": "Formaterer i tidssonen koden kjører i — UTC i API-containeren og på SSR-serveren, Europe/Oslo i nettleseren. Bruk formatOsloDate / formatOsloDateTime (apps/kvark/src/lib/date.ts, apps/api/src/lib/oslo-day.ts, packages/email/src/date.ts)."
                    }
                ]
            }
        },
        {
            "files": [
                "apps/api/src/lib/oslo-day.ts",
                "packages/auth/src/academic-year.ts",
                "packages/core/src/slug.ts",
                "packages/email/src/date.ts"
            ],
            "rules": {
                "no-restricted-properties": "off"
            }
        }
    ]
}
